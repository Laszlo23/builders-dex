# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Optional model override (default: gemini-3.7-flash)
# Stable models: gemini-3.7-flash, gemini-3.6-flash, gemini-3.5-flash
# Preview: gemini-3-flash-preview
# API calls have 60s timeout with fallback to older models
# GEMINI_MODEL="gemini-3.7-flash"

# JUPITER_API_KEY: Required for production-rate Jupiter Swap / Tokens API.
# Create a key at https://portal.jup.ag — keep this server-side only.
# Keyless access works at very low rate limits for local prototypes.
JUPITER_API_KEY="MY_JUPITER_API_KEY"

# NEYNAR_API_KEY: Optional — live Farcaster / Neynar user scores on Passport™.
# Without it, /api/neynar/score returns a deterministic demo score.
# NEYNAR_API_KEY="MY_NEYNAR_API_KEY"

# TALENT_API_KEY: Optional — live Top 7 builders from Talent Protocol (talent.app).
# Without it, /api/talent/top-builders returns curated Top 7 with talent.app links.
# Create a key at https://docs.talent.app — header X-API-KEY.
# TALENT_API_KEY="MY_TALENT_API_KEY"

# FEEDBACK_ADMIN_TOKEN: Required to read GET /api/feedback (inbox dump)
# and to POST /api/raises, /api/raises/:id/attest, /api/raises/:id/sync.
# Keep secret — without it those endpoints return 401/503.
# FEEDBACK_ADMIN_TOKEN="change-me-long-random"

# Optional Solana RPC for wallet balance reads (Swap V2 execute does not need this).
# VITE_SOLANA_RPC_URL="https://api.mainnet-beta.solana.com"
# VITE_SOLANA_DEVNET_RPC_URL="https://api.devnet.solana.com"

# --- Builder Passport On-Chain (Devnet) ---
# Builder Passport program ID (deployed to devnet)
# Set this to enable on-chain passport minting in the frontend
VITE_BUILDER_PASSPORT_PROGRAM_ID="7MWCkrbSxv5tsBSbSUwiH5C6iztBwe4CksjrRA7VSQnD"

# Server-side program ID (defaults to VITE_ value if unset)
# BUILDER_PASSPORT_PROGRAM_ID="7MWCkrbSxv5tsBSbSUwiH5C6iztBwe4CksjrRA7VSQnD"

# Oracle keypair for updating on-chain passport scores
# REQUIRED for server-side score updates (Scout, Applications)
# Format: Base58 private key OR JSON byte array [1,2,3,...]
# Example Base58: 5Jv... (88 chars, from `solana-keygen new`)
# Example JSON: [1,2,3,...,64] (64-byte secret key array)
# SECURITY: Never commit this to git. Set via Cloud Secrets or .env.local
# The oracle pubkey must match config.oracle in the Config PDA
# To generate: `solana-keygen new --outfile oracle-keypair.json`
# Then base58: `solana-keygen pubkey oracle-keypair.json` (for Config PDA init)
# PASSPORT_ORACLE_SECRET_KEY="YOUR_ORACLE_PRIVATE_KEY_BASE58_OR_JSON"

# Devnet RPC endpoint for oracle transactions
# Defaults to public devnet RPC if unset
# For production, use a paid RPC (Helius, Triton, QuickNode) to avoid rate limits
SOLANA_DEVNET_RPC_URL="https://api.devnet.solana.com"

# Admin token for applications review, raise create/attest, and the /review desk.
# Falls back to FEEDBACK_ADMIN_TOKEN if unset
# Required for POST /api/applications/:id/review and /curate
# APPLICATIONS_ADMIN_TOKEN="change-me-long-random"

# Applications storage path (optional)
# Defaults to ./data/applications.jsonl
# APPLICATIONS_FILE_PATH="./data/applications.jsonl"

# Optional — raises GitHub API rate limits for live Builder Score™ pipeline.
# Without it, public unauthenticated limits apply (cached ~45m).
# GITHUB_TOKEN="ghp_..."

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="https://dex.buildingcultureid.space"

# --- Telegram Builder Token Bot ---
# Create a bot via @BotFather. Webhook: POST /api/telegram/webhook
# TELEGRAM_BOT_TOKEN="123456:ABC..."           # official platform bot (@BotFather)
# TELEGRAM_WEBHOOK_SECRET="long-random-secret"  # REQUIRED — webhook rejects without it
# TELEGRAM_ADMIN_TOKEN="change-me-long-random"  # REQUIRED for POST /api/telegram/bots/register
#   (falls back to FEEDBACK_ADMIN_TOKEN if unset)
# TELEGRAM_TREND_THRESHOLD=25                  # unique votes → Community Trending
# TELEGRAM_DB_PATH="/var/www/dex-buildingculture/data/builder-bot.sqlite"
# Local default: ./data/builder-bot.sqlite
# Users can also register their own bots via the DEX UI (More → Telegram bot)
# → POST /api/telegram/bots/register (admin token + sets webhook to /api/telegram/webhook/:id)
# Token profiles (mint, logo, banner, socials): POST /api/telegram/tokens/submit
#   (chat must already be known via /chatid)
# TELEGRAM_BIG_BUY_USD=1000          # default whale alert threshold
# TELEGRAM_BIG_BUY_POLL_MS=60000     # GeckoTerminal trade poll interval
# TELEGRAM_BIG_BUY_DISABLE=0
# TELEGRAM_RADAR_CHAT_ID="-100..."    # optional: daily Radar digest push (once/UTC day)

# --- Index pipeline (Telegram → curation queue) ---
# POST /api/index/candidates/from-telegram { telegramTokenId }
# GET  /api/index/candidates
# POST /api/index/candidates/:id/status  (admin token)

# --- Tradeable tokens (Solana / Jupiter) ---
# Only coins with TRADEABLE_<SYMBOL>=true can be quoted or swapped.
# If a key is omitted: SOL, USDC, USDT, JUP default ON; BONK, WIF, RAY default OFF.
TRADEABLE_SOL=true
TRADEABLE_USDC=true
TRADEABLE_USDT=true
TRADEABLE_JUP=true
TRADEABLE_BONK=false
TRADEABLE_WIF=false
TRADEABLE_RAY=false
# AURA: Aura OS ERC-20 on Base (confirmed). Jupiter TRADEABLE_AURA stays off
# until a Solana wrap mint exists — do not invent one. Hood hop does not
# enable TRADEABLE_AURA or port Passport / builder_raise off Solana.
# TRADEABLE_AURA=false
AURA_BASE_ADDRESS="0xDb1E6D4FaB43c8cb5871D32D41df00ea34350723"
AURA_SOLANA_MINT=""
VITE_AURA_BASE_ADDRESS="0xDb1E6D4FaB43c8cb5871D32D41df00ea34350723"
VITE_AURA_SOLANA_MINT=""
# Published founder / deployer wallet shown on /aura (Base).
AURA_DEV_WALLET="0x7894a4f43cec1e97cbaa9cd6676ac07abf34dd49"
# Optional Base JSON-RPC for live founder-wallet balances on /aura.
# BASE_RPC_URL="https://mainnet.base.org"

# Robinhood Chain (4663). Official RPC/explorer only. Cubes live board uses this.
# HOOD_RPC_URL="https://rpc.mainnet.chain.robinhood.com"
# VITE_HOOD_RPC_URL="https://rpc.mainnet.chain.robinhood.com"
# Deployer for the HoodShare ERC-721 (Accelerator mint on chain 4663). Same 0x as AURA_DEV_WALLET.
# Never commit. Prefer HOOD_DEPLOYER_PRIVATE_KEY; PRIVATE_KEY is accepted as an alias.
# HOOD_DEPLOYER_PRIVATE_KEY="0x..."

# --- Builder Passport Mainnet canary ---
# Paid mainnet RPC for oracle + client (required for production)
# SOLANA_RPC_URL="https://mainnet.helius-rpc.com/?api-key=..."
# VITE_SOLANA_RPC_URL="https://mainnet.helius-rpc.com/?api-key=..."
# PASSPORT_CLUSTER="devnet"          # or mainnet-beta
# VITE_PASSPORT_MAINNET_MINT=false   # flip true only after mainnet Config PDA exists
# VITE_PASSPORT_COLLECTION_MINT=""   # Metaplex Core collection (optional Phase 5)
VITE_BUILDER_RAISE_PROGRAM_ID="6weAy9KBNBf6MFsiA4csnEj5yJEhLV5nA5fzvnHD6wS2"
BUILDER_RAISE_PROGRAM_ID="6weAy9KBNBf6MFsiA4csnEj5yJEhLV5nA5fzvnHD6wS2"
VITE_RAISE_MAINNET_MINT=false      # keep false until Devnet E2E + funded deploy

# Avantis perps (Base) — Python sidecar uses avantis-trader-sdk for pairs + marks.
# Candles fall back to Binance public klines when the sidecar is offline.
# AVANTIS_SIDECAR_URL must be loopback only (SSRF guard).
# AVANTIS_BASE_RPC="https://mainnet.base.org"
# AVANTIS_SIDECAR_URL="http://127.0.0.1:8765"
# AVANTIS_SIDECAR_DISABLE="0"

# Show "STILL IN DEVELOPMENT" ribbon (staging only — default OFF for production)
# VITE_SHOW_DEV_RIBBON=false
